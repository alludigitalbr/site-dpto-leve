# Rastreamento (opcional). Sem IDs, nenhum script de terceiros é carregado
# e o aviso de cookies não aparece.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Google Ads (tag direta, sem GTM). ID no formato AW-XXXXXXXXX.
# O rótulo da conversão de compra é disparado na página /obrigado.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Páginas legais (opcional). Os links só aparecem no rodapé quando definidos.
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=

# Endereço de login da plataforma (opcional). Exibe "Entrar" no cabeçalho e no rodapé.
NEXT_PUBLIC_APP_LOGIN_URL=
